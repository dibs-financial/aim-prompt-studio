# xAI (Grok) — required for Run / Enhance on the Grok platform
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Anthropic (Claude) — optional. When set, Claude appears as a platform in Settings.
ANTHROPIC_API_KEY=

# Better Auth — optional in this preview (models are open). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
